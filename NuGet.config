<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- maui-labs preview/CI builds for Microsoft.Maui.Platforms.MacOS and Platform.Maui.Linux.Gtk4 -->
    <add key="dotnet10" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet10/nuget/v3/index.json" />
  </packageSources>
  <!-- Central package management wants every package tied to a source: the maui-labs packages come from
       dotnet10, everything else from nuget.org. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnet10">
      <package pattern="Microsoft.Maui.Platforms.*" />
      <package pattern="Microsoft.Maui.DevFlow.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
