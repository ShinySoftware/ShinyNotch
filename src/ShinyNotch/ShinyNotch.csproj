<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-macos</TargetFramework>
        <OutputType>Exe</OutputType>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <IsPackable>false</IsPackable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>ShinyNotch</RootNamespace>

        <!-- No space: the bundle is named from this, and a space in the .app name kept the platform's MauiMenuBar.bundle out of it (startup crash). The menu-bar name comes from CFBundleDisplayName. -->
        <ApplicationTitle>ShinyNotch</ApplicationTitle>
        <ApplicationId>net.shiny.notch</ApplicationId>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>
        <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
        <!-- Apple silicon only: the camera notch only exists on Apple silicon MacBooks. One RID also keeps
             Release from building a universal app (whose per-RID osx-arm64 folder is an unsigned,
             incomplete intermediate - the real app would be one level up). -->
        <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    </PropertyGroup>

    <!-- Distribution outside the App Store: Developer ID signing with the hardened runtime, which
         notarization requires. CI passes CodesignKey; local Release builds without it stay ad-hoc signed. -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
        <UseHardenedRuntime>true</UseHardenedRuntime>
        <EnableCodeSigning>true</EnableCodeSigning>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.100" />
        <PackageReference Include="Microsoft.Maui.Platforms.MacOS" Version="0.1.0-preview.13.26514.2" />
        <PackageReference Include="Microsoft.Maui.Platforms.MacOS.Essentials" Version="0.1.0-preview.13.26514.2" />
    </ItemGroup>

    <ItemGroup>
        <!-- appicon.svg is the source; the PNG is rendered from it (rsvg-convert -w 1024 -h 1024) because
             the platform's icon step resizes with sips, which does not read SVG. -->
        <MauiIcon Include="Resources/AppIcon/appicon.png" />
        <None Include="Resources/AppIcon/appicon.svg" />
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <PackageReference Include="Microsoft.Maui.DevFlow.Agent" Version="0.1.0-preview.13.26514.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../ShinyNotch.Core/ShinyNotch.Core.csproj" />
    </ItemGroup>

    <!-- Referenced here too, not only through Core: Core is net10.0, so these resolve their macOS
         assets only when this head asks for them. -->
    <ItemGroup>
        <PackageReference Include="Shiny.Calendar" Version="6.3.1-beta-0001" />
        <PackageReference Include="Shiny.Core" Version="6.3.1-beta-0001" />
        <PackageReference Include="Shiny.Extensions.Stores" Version="6.0.1" />
        <PackageReference Include="Shiny.Maui.Controls" Version="2.0.0-beta-0010" />
        <PackageReference Include="Shiny.Maui.Controls.Desktop" Version="2.0.0-beta-0010" />
    </ItemGroup>
</Project>
