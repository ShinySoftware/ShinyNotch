<Project Sdk="Microsoft.NET.Sdk">
    <!-- Everything the notch is that isn't tied to an OS: the views, the controller, Settings and the
         services on top of the Platform interfaces. Plain net10.0, so the macOS, Windows and GTK heads all
         take it; each head supplies the Platform implementations. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <IsPackable>false</IsPackable>
        <RootNamespace>ShinyNotch</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.100" />
        <PackageReference Include="Shiny.Calendar" Version="6.3.1-beta-0001" />
        <PackageReference Include="Shiny.Core" Version="6.3.1-beta-0001" />
        <PackageReference Include="Shiny.Extensions.Stores" Version="6.0.1" />
        <PackageReference Include="Shiny.Maui.Controls" Version="2.0.0-beta-0010" />
        <PackageReference Include="Shiny.Maui.Controls.Desktop" Version="2.0.0-beta-0010" />
    </ItemGroup>

    <ItemGroup>
        <!-- The heads build platform tabs (macshot's Capture tab) from the same Ui helpers. -->
        <InternalsVisibleTo Include="ShinyNotch" />
        <InternalsVisibleTo Include="ShinyNotch.Windows" />
        <InternalsVisibleTo Include="ShinyNotch.Linux" />
    </ItemGroup>
</Project>
