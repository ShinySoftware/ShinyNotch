<Project Sdk="Microsoft.NET.Sdk">
    <!-- The GTK 4 head. A plain net10.0 app, not UseMaui: the Linux platform package brings its own
         MAUI hosting. Everything shared is in Core; this supplies the Platform implementations. -->
    <PropertyGroup>
        <ShinyDIExtensionMethodName>AddPlatformServices</ShinyDIExtensionMethodName>
        <ShinyDIExtensionNamespace>ShinyNotch.Linux</ShinyDIExtensionNamespace>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <RootNamespace>ShinyNotch</RootNamespace>
        <AssemblyName>ShinyNotch.Linux</AssemblyName>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <!-- What UseMaui would have made global. -->
        <Using Include="Microsoft.Maui" />
        <Using Include="Microsoft.Maui.Controls" />
        <Using Include="Microsoft.Maui.Dispatching" />
        <Using Include="Microsoft.Maui.Graphics" />
        <Using Include="Microsoft.Maui.Hosting" />
        <Using Include="Microsoft.Extensions.DependencyInjection" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../ShinyNotch.Core/ShinyNotch.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" />
        <PackageReference Include="Microsoft.Maui.Platforms.Linux.Gtk4" />
        <PackageReference Include="Microsoft.Maui.Platforms.Linux.Gtk4.Essentials" />
        <!-- MPRIS, logind and GeoClue are all D-Bus. -->
        <PackageReference Include="Tmds.DBus.Protocol" />
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <PackageReference Include="Microsoft.Maui.DevFlow.Agent.Gtk" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Shiny.Audio.Linux" />
        <PackageReference Include="Shiny.Calendar" />
        <PackageReference Include="Shiny.Core" />
        <PackageReference Include="Shiny.Extensions.Stores" />
        <PackageReference Include="Shiny.Maui.Controls" />
        <PackageReference Include="Shiny.Maui.Controls.Desktop" />
    </ItemGroup>
</Project>
